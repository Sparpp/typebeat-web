<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Local feed for typebeat.Game.Resources: too large to vendor in git (116 MB > GitHub's
         100 MB limit), so CI packs it from the external/type-beat-assets submodule into this
         folder before restore (see .github/workflows/ci.yml). Locally the folder is empty and
         the package resolves from the global cache instead. -->
    <add key="local" value="external/packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
