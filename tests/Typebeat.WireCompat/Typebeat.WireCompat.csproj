<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Stage C wire-compat harness. A net10 test project that boots the real server via
    WebApplicationFactory<Program> and deserializes its raw JSON responses with the GAME
    CLIENT'S OWN DTO types (typebeat.Game, net8.0) using Newtonsoft (the same primitive the
    client's OsuJsonWebRequest uses). Contract drift between server and client therefore breaks
    a test here instead of production.

    A net10 test project referencing a net8 library is supported. The typebeat.Game reference
    (relative path today; a git submodule in CI) drags in osu.Framework et al., expected and
    fine for a test project. typebeat.Game is built with its OWN Directory.Build.props (it lives
    in the typebeat-osu tree), so none of its analyzer/nullable settings leak into this project.

    The typebeat RULESET is referenced too (backlog 74): the mirrored halves of the scoring code
    (PerformancePoints, LyricDifficulty, the mods) live there, not in typebeat.Game, and this is
    the only project that can hold the two repos' copies against each other.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Test packages: versions from tests/Typebeat.Web.Tests, except NUnit which is bumped from
         4.3.2 to 4.5.1 to clear the transitive floor typebeat.Game imposes (it PackageReferences
         NUnit >= 4.5.1; keeping 4.3.2 is an NU1605 downgrade error). -->
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.0" />
    <PackageReference Include="NUnit" Version="4.5.1" />
    <PackageReference Include="NUnit.Analyzers" Version="4.7.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.0.0" />

    <!-- In-process host for real HTTP calls through the server pipeline. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10" />

    <!-- Direct DB access for fixture create/seed. (Also flows transitively from Typebeat.Web.) -->
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Typebeat.Web\Typebeat.Web.csproj" />

    <!-- The score-recalculation tool (backlog 114) is tested here for the same reason this project
         exists: it is the only place both repos compile, and the tool spans them (the game's engine
         re-derives the statistics, the server's ScoringContract and PerformancePoints value them).
         The tool resolves the game through the SAME two overridable properties below, so it never
         drags in a second copy. -->
    <ProjectReference Include="..\..\tools\score-recalc\Typebeat.Tools.ScoreRecalc.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Local dev prefers the LIVE sibling checkout of the game repo, so wire drift surfaces
         the moment client code changes. CI has no sibling and falls back to the pinned
         external/typebeat-osu submodule. -->
    <TypebeatGameProject Condition="Exists('..\..\..\typebeat-osu\typebeat.Game\typebeat.Game.csproj')">..\..\..\typebeat-osu\typebeat.Game\typebeat.Game.csproj</TypebeatGameProject>
    <TypebeatGameProject Condition="'$(TypebeatGameProject)' == ''">..\..\external\typebeat-osu\typebeat.Game\typebeat.Game.csproj</TypebeatGameProject>

    <!-- Same two-step resolution for the typebeat RULESET, which is where the mirrored halves of
         the scoring code live (PerformancePoints, LyricDifficulty, the mods). Kept as its own
         property rather than derived from the one above so a caller can point either at a
         worktree independently. -->
    <TypebeatRulesetProject Condition="Exists('..\..\..\typebeat-osu\typebeat.Game.Rulesets.TypeBeat\typebeat.Game.Rulesets.TypeBeat.csproj')">..\..\..\typebeat-osu\typebeat.Game.Rulesets.TypeBeat\typebeat.Game.Rulesets.TypeBeat.csproj</TypebeatRulesetProject>
    <TypebeatRulesetProject Condition="'$(TypebeatRulesetProject)' == ''">..\..\external\typebeat-osu\typebeat.Game.Rulesets.TypeBeat\typebeat.Game.Rulesets.TypeBeat.csproj</TypebeatRulesetProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(TypebeatGameProject)" />
    <ProjectReference Include="$(TypebeatRulesetProject)" />
  </ItemGroup>

  <!-- RomaniserParityTest (backlog 329) reads the romaniser fixtures from the GAME repo, where its
       own RomaniserTest reads them, so both sides are held to one file per script; and both
       copies of Romaniser.cs as text, to pin that they differ only in the namespace line. All
       three resolve through the same ruleset property as the project reference above. -->
  <PropertyGroup>
    <TypebeatRulesetDir>$([System.IO.Path]::GetDirectoryName('$(TypebeatRulesetProject)'))</TypebeatRulesetDir>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(TypebeatRulesetDir)\..\typebeat.Game.Rulesets.TypeBeat.Tests\NonVisual\fixtures\romaniser\*.tsv" Link="RomaniserFixtures\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(TypebeatRulesetDir)\Beatmaps\Romaniser.cs" Link="RomaniserMirror\game.cs.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\Typebeat.Web\Packages\Lyrics\Romaniser.cs" Link="RomaniserMirror\server.cs.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
