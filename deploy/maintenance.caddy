# Maintenance switch and the swap-window page (backlog 368). Imported into each app site block of
# deploy/Caddyfile with one `import maintenance.caddy` line, so the Caddyfile itself barely changes.
#
#   ON:   touch /opt/typebeat-web/deploy/maintenance.on
#   OFF:  rm /opt/typebeat-web/deploy/maintenance.on
#
# No reload needed: caddy mounts deploy/ as a DIRECTORY (compose.prod.yml), and the file matcher
# stats the flag on every request. deploy/maintenance.on is git-ignored, so a deploy's source tar
# neither creates nor removes it: a flag you turned on stays on until you remove it.
#
# While it is on, every request answers 503 with Retry-After: a browser page load (a GET or HEAD
# that asks for text/html, outside the wire prefixes) gets the small page below, everything else
# (the game client, the updater, the web player's fetches) a PLAIN-TEXT body, because clients
# string-match response bodies and must never be handed an HTML page. The game retries a 503 on
# its submission routes as a gateway blip, so an upload sent during maintenance lands afterwards.
#
# /health and /health/ready are NEVER held: the CI health check (and the automatic rollback that
# hangs off it) and the uptime monitor must keep seeing the app itself. Turning maintenance on
# before a push therefore does not fail the deploy.

@maintenance {
	file {
		root /etc/caddy/deploy
		try_files maintenance.on
	}
	not path /health /health/*
}

@maintenance_page {
	method GET HEAD
	header Accept *text/html*
	not path /api/* /bss/* /oauth/* /ws/* /releases/* /health /health/*
}

handle @maintenance {
	header Retry-After 120
	header Cache-Control no-store

	handle @maintenance_page {
		header Content-Type "text/html; charset=utf-8"
		respond `<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta http-equiv="refresh" content="60"><title>type!beat: maintenance</title><style>body{margin:0;min-height:100vh;display:grid;place-items:center;background:#111;color:#eee;font:16px/1.5 system-ui,sans-serif;text-align:center;padding:16px}h1{font-size:1.5rem;margin:0 0 .5rem}p{margin:0;color:#aaa}</style></head><body><main><h1>type!beat is down for maintenance</h1><p>Back in a few minutes. This page reloads itself.</p></main></body></html>` 503
	}

	handle {
		respond "type!beat is down for maintenance, back in a few minutes." 503
	}
}

# The swap window: between the old container stopping and the new one listening, reverse_proxy
# cannot reach app:8080 and fails with a 502. A browser page load gets a "restarting" page as a
# 503 with Retry-After instead of a bare 502; every other request keeps the bare 502 (no route
# matches it here, so Caddy writes the status alone), which is what the game already treats as a
# gateway blip and retries.
handle_errors {
	@restarting_page {
		expression {err.status_code} == 502
		method GET HEAD
		header Accept *text/html*
		not path /api/* /bss/* /oauth/* /ws/* /releases/* /health /health/*
	}

	handle @restarting_page {
		header Retry-After 15
		header Cache-Control no-store
		header Content-Type "text/html; charset=utf-8"
		respond `<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta http-equiv="refresh" content="15"><title>type!beat: restarting</title><style>body{margin:0;min-height:100vh;display:grid;place-items:center;background:#111;color:#eee;font:16px/1.5 system-ui,sans-serif;text-align:center;padding:16px}h1{font-size:1.5rem;margin:0 0 .5rem}p{margin:0;color:#aaa}</style></head><body><main><h1>type!beat is restarting</h1><p>An update is going out. This page reloads itself in a few seconds.</p></main></body></html>` 503
	}
}
