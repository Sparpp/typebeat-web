@page "/reset-password"
@model ResetPasswordModel
@{
    ViewData["Title"] = "Set a new password";
}

<div class="card auth-card">
    <h1>Set a new password</h1>

    <p class="muted">Enter the 6-digit code we emailed you, then choose a new password.</p>

    @if (Model.Error is not null)
    {
        <div class="alert-error">@Model.Error</div>
    }
    @if (Model.Status is not null)
    {
        <div class="alert-info">@Model.Status</div>
    }

    <form method="post">
        @Html.AntiForgeryToken()
        <div class="field">
            <label asp-for="Code">6-digit code</label>
            <input class="input code-input" asp-for="Code" inputmode="numeric" autocomplete="one-time-code"
                   maxlength="6" pattern="[0-9]{6}" autofocus required />
        </div>
        <div class="field">
            <label asp-for="NewPassword">New password</label>
            <input class="input" asp-for="NewPassword" type="password" autocomplete="new-password" required />
            @foreach (string e in Model.PasswordErrors)
            {
                <div class="field-error">@e</div>
            }
            <div class="field-hint">At least 8 characters.</div>
        </div>
        <div class="field">
            <label asp-for="ConfirmPassword">Confirm new password</label>
            <input class="input" asp-for="ConfirmPassword" type="password" autocomplete="new-password" required />
        </div>
        <button type="submit" class="btn btn-primary">Reset password</button>
    </form>

    <div class="card-note">
        Didn't get a code? Check your spam folder, or
        <form class="resend-form" method="post" asp-page-handler="Resend">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn-link">send a new code</button>
        </form>.
    </div>
    <p class="card-note"><a href="/forgot-password">Start over with a different email</a></p>
</div>
