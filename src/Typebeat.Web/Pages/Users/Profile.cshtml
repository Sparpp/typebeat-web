@page "/users/{idOrName}"
@using System.Globalization
@using Microsoft.AspNetCore.Html
@using Typebeat.Web.Pages.Users
@model Typebeat.Web.Pages.Users.ProfileModel
@{
    // Where a no-JS follow/watch submit sends the user back to (this profile, query string kept).
    string followReturnUrl = Model.Request.Path + Model.Request.QueryString;

    // Owner-only chrome: the reorder handles, the hidden form that carries their antiforgery
    // token, and the script that wires them. Everything else on this page is identical for
    // every visitor, including the section ORDER, which is the owner's and is served to all.
    bool owner = Model.IsOwnProfile;

    bool preferOriginal = Model.CurrentUser?.PreferOriginalMetadata ?? false;
}

<section class="profile-header">
    @if (Model.ProfileUser.CoverUrl is string coverUrl)
    {
        <img class="profile-cover profile-cover--image" src="@coverUrl" alt="" aria-hidden="true" />
    }
    else
    {
        <div class="profile-cover profile-cover--@(Model.ProfileUser.Id % ProfileModel.CoverPresetCount)" aria-hidden="true"></div>
    }
    <div class="profile-header__bar">
        @if (Model.ProfileUser.AvatarUrl is string avatarUrl)
        {
            <img class="profile-avatar" src="@avatarUrl" alt="" />
        }
        else
        {
            <span class="profile-avatar profile-avatar--fallback" aria-hidden="true">@Model.ProfileUser.Username[..1]</span>
        }
        <div class="profile-header__who">
            <h1 class="profile-header__name">@Model.ProfileUser.Username</h1>
            <div class="profile-header__dates faint">
                Joined @Model.ProfileUser.CreatedAt.ToString("d MMM yyyy", CultureInfo.InvariantCulture)
                &middot; Last seen @ProfileModel.LastSeenLabel(Model.ProfileUser.LastVisit)
            </div>
            <div class="profile-header__social">
                <a class="profile-social" href="/users/@Model.ProfileUser.Id/followers">
                    <span class="profile-social__num" data-follower-count>@Model.FollowState.Followers.ToString("N0", CultureInfo.InvariantCulture)</span>
                    <span class="profile-social__label">@(Model.FollowState.Followers == 1 ? "follower" : "followers")</span>
                </a>
                <a class="profile-social" href="/users/@Model.ProfileUser.Id/following">
                    <span class="profile-social__num" data-following-count>@Model.FollowState.Following.ToString("N0", CultureInfo.InvariantCulture)</span>
                    <span class="profile-social__label">following</span>
                </a>
            </div>
        </div>
        @if (Model.IsOwnProfile)
        {
            <div class="profile-header__actions">
                <a class="btn btn-ghost btn-small" href="/watching">notifications</a>
                <a class="btn btn-ghost btn-small profile-header__edit" href="/settings">edit profile</a>
            </div>
        }
        else
        {
            <div class="profile-header__actions">
                @if (Model.CurrentUser is not null)
                {
                    <form class="js-follow-form" method="post" asp-page="/Users/Profile"
                          asp-route-idOrName="@Model.ProfileUser.Id" asp-page-handler="Follow">
                        <input type="hidden" name="returnUrl" value="@followReturnUrl" />
                        <button type="submit" class="btn btn-small @(Model.FollowState.ViewerFollows ? "btn-ghost is-on" : "btn-primary")"
                                data-follow-btn data-follow-kind="user">
                            @(Model.FollowState.ViewerFollows ? "following" : "follow")
                        </button>
                    </form>
                    <form class="js-follow-form" method="post" asp-page="/Users/Profile"
                          asp-route-idOrName="@Model.ProfileUser.Id" asp-page-handler="Watch">
                        <input type="hidden" name="returnUrl" value="@followReturnUrl" />
                        <button type="submit" class="bell-btn @(Model.FollowState.ViewerWatches ? "is-on" : "")"
                                data-follow-btn data-follow-kind="mapper"
                                title="@(Model.FollowState.ViewerWatches ? "Stop watching this mapper" : "Watch this mapper for new maps")"
                                aria-label="@(Model.FollowState.ViewerWatches ? "Stop watching this mapper" : "Watch this mapper for new maps")">
                            <span aria-hidden="true">&#128276;</span>
                        </button>
                    </form>
                }
                else
                {
                    <a class="btn btn-primary btn-small" href="/login" title="Sign in to follow">follow</a>
                    <a class="bell-btn" href="/login" title="Sign in to watch this mapper" aria-label="Sign in to watch this mapper">
                        <span aria-hidden="true">&#128276;</span>
                    </a>
                }
            </div>
        }
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(Model.ProfileUser.Description))
{
    <section class="profile-about card">
        <p class="profile-about__text">@Model.ProfileUser.Description</p>
    </section>
}

@{
    @* ---- The section blocks ----------------------------------------------------------------
       One templated Razor delegate per section, keyed by its slug in ProfileSections. This
       dictionary IS the join between the stored order array (026_profile_order.sql) and this
       page's markup, the way osu-web's data-page-id joins its order array to its React blocks:
       the loop below walks Model.SectionOrder and renders whatever each id names, so reordering
       is a server-side property of the list and never of the markup.

       Every block carries data-section-id, which is what profile-reorder.js reads back out of
       the DOM after a drag. Sections that hide themselves when empty leave an EMPTY, hidden slot
       carrying the same attribute on the owner's own page, so a section that has nothing to show
       today still holds its place in the order the owner drags out (without one, it would drop
       out of the submitted array and reappear at the bottom the day it fills up).
    *@
    var blocks = new Dictionary<string, Func<object?, IHtmlContent>>(StringComparer.Ordinal);

    @* Pinned: the owner's own curation. Hidden entirely when there is nothing pinned (no heading,
       no empty state), since a visitor has no reason to be told about a section that only its
       owner can fill. The anchor stays either way so the pin/unpin redirect has somewhere to land,
       which also makes this the one section that never needs a separate empty slot. *@
    blocks[ProfileSections.Pinned] = @<div id="pinned" data-section-id="@ProfileSections.Pinned">
        @* Own profile only: the notice is only ever produced by the owner's own refused POST,
           so a hand-typed ?pin= on somebody else's profile must not paint one there. *@
        @if (owner && Model.PinNotice is string pinNotice)
        {
            <div class="alert-error">@pinNotice</div>
        }
        @if (Model.PinnedScores.Count > 0)
        {
            <section class="profile-section">
                <div class="profile-section__head">
                    <h2>Pinned</h2>
                    <partial name="_SectionHandle" model='new SectionHandle(owner, "Pinned")' />
                </div>
                <div class="score-list">
                    @foreach (var row in Model.PinnedScores)
                    {
                        <partial name="_ScoreRow" model="row" />
                    }
                </div>
            </section>
        }
    </div>;

    blocks[ProfileSections.BestScores] = @<section class="profile-section" id="best-scores" data-section-id="@ProfileSections.BestScores">
        <div class="profile-section__head">
            <h2>Best scores</h2>
            <partial name="_SectionHandle" model='new SectionHandle(owner, "Best scores")' />
        </div>
        @if (Model.BestScores.Count == 0)
        {
            <p class="profile-empty muted">No scores yet, the keyboard is waiting.</p>
        }
        else
        {
            <div class="score-list">
                @foreach (var row in Model.BestScores)
                {
                    <partial name="_ScoreRow" model="row" />
                }
            </div>
        }
    </section>;

    @* First places: the maps this user currently tops. Hidden entirely when there are none,
       like Pinned, since "no first places" is the ordinary case and needs no empty state. *@
    blocks[ProfileSections.FirstPlaces] = @<text>
        @if (Model.FirstPlaces.Count > 0)
        {
            <section class="profile-section" id="first-places" data-section-id="@ProfileSections.FirstPlaces">
                <div class="profile-section__head">
                    <h2>First places</h2>
                    <partial name="_SectionHandle" model='new SectionHandle(owner, "First places")' />
                </div>
                <div class="score-list">
                    @foreach (var row in Model.FirstPlaces)
                    {
                        <partial name="_ScoreRow" model="row" />
                    }
                </div>
                @if (Model.FirstPlaceCount > Model.FirstPlaces.Count)
                {
                    <p class="profile-empty faint">Showing @Model.FirstPlaces.Count.ToString("N0", CultureInfo.InvariantCulture) of @Model.FirstPlaceCount.ToString("N0", CultureInfo.InvariantCulture) first places.</p>
                }
            </section>
        }
        else if (owner)
        {
            <div class="profile-section-slot" data-section-id="@ProfileSections.FirstPlaces" hidden></div>
        }
    </text>;

    blocks[ProfileSections.RecentScores] = @<section class="profile-section" id="recent-scores" data-section-id="@ProfileSections.RecentScores">
        <div class="profile-section__head">
            <h2>Recent scores</h2>
            <partial name="_SectionHandle" model='new SectionHandle(owner, "Recent scores")' />
        </div>
        @if (Model.RecentScores.Count == 0)
        {
            <p class="profile-empty muted">Nothing typed lately.</p>
        }
        else
        {
            <div class="score-list">
                @foreach (var row in Model.RecentScores)
                {
                    <partial name="_ScoreRow" model="row" />
                }
            </div>
        }
    </section>;

    blocks[ProfileSections.MostPlayed] = @<section class="profile-section" id="most-played" data-section-id="@ProfileSections.MostPlayed">
        <div class="profile-section__head">
            <h2>Most played</h2>
            <partial name="_SectionHandle" model='new SectionHandle(owner, "Most played")' />
        </div>
        @if (Model.MostPlayed.Count == 0)
        {
            <p class="profile-empty muted">No plays on record yet.</p>
        }
        else
        {
            <div class="score-list">
                @foreach (var row in Model.MostPlayed)
                {
                    string mpTitle = row.DisplayTitle(preferOriginal);
                    string mpArtist = row.DisplayArtist(preferOriginal);
                    <div class="score-row">
                        <div class="score-row__thumb">
                            @if (row.CoverUrl is not null)
                            {
                                <img src="@row.CoverUrl" alt="" loading="lazy" />
                            }
                            else
                            {
                                <div class="cover-fallback" aria-hidden="true"></div>
                            }
                        </div>
                        <a class="score-row__map" href="/beatmapsets/@row.SetId" title="@mpTitle [@mpArtist]">
                            @mpTitle <span class="score-row__artist">[@mpArtist]</span>
                        </a>
                        @if (row.Explicit)
                        {
                            <partial name="_ExplicitBadge" />
                        }
                        <span class="score-row__plays">@row.Plays.ToString("N0", CultureInfo.InvariantCulture) plays</span>
                    </div>
                }
            </div>
        }
    </section>;

    @* Most viewed replays (025_replay_views.sql): the plays other people came back to watch.
       Sits with the other score lists rather than with the charts, and directly above the
       chart of the same data over time. Hidden entirely when nothing of theirs was ever
       watched, which is every profile until views start landing. *@
    blocks[ProfileSections.MostViewedReplays] = @<text>
        @if (Model.MostViewedReplays.Count > 0)
        {
            <section class="profile-section" id="most-viewed-replays" data-section-id="@ProfileSections.MostViewedReplays">
                <div class="profile-section__head">
                    <h2>Most viewed replays</h2>
                    <partial name="_SectionHandle" model='new SectionHandle(owner, "Most viewed replays")' />
                </div>
                <div class="score-list">
                    @foreach (var row in Model.MostViewedReplays)
                    {
                        <partial name="_ScoreRow" model="row" />
                    }
                </div>
            </section>
        }
        else if (owner)
        {
            <div class="profile-section-slot" data-section-id="@ProfileSections.MostViewedReplays" hidden></div>
        }
    </text>;

    @* The same views, per month. Hidden on the same condition as the list above. *@
    blocks[ProfileSections.ReplayViews] = @<text>
        @if (Model.ReplayViewsChart is BarChartModel replayViews)
        {
            <section class="profile-section" id="replay-views" data-section-id="@ProfileSections.ReplayViews">
                <div class="profile-section__head">
                    <h2>Replay views</h2>
                    <partial name="_SectionHandle" model='new SectionHandle(owner, "Replay views")' />
                </div>
                <partial name="_BarChart" model="replayViews" />
            </section>
        }
        else if (owner)
        {
            <div class="profile-section-slot" data-section-id="@ProfileSections.ReplayViews" hidden></div>
        }
    </text>;

    @* Play history (024_play_history.sql), next to Most played because they answer the same
       question from two directions: what you played, and when. Hidden entirely for a user
       with no recorded month, like Pinned: an empty chart states nothing. *@
    blocks[ProfileSections.PlayHistory] = @<text>
        @if (Model.PlayHistoryChart is BarChartModel playHistory)
        {
            <section class="profile-section" id="play-history" data-section-id="@ProfileSections.PlayHistory">
                <div class="profile-section__head">
                    <h2>Play history</h2>
                    <partial name="_SectionHandle" model='new SectionHandle(owner, "Play history")' />
                </div>
                <partial name="_BarChart" model="playHistory" />
            </section>
        }
        else if (owner)
        {
            <div class="profile-section-slot" data-section-id="@ProfileSections.PlayHistory" hidden></div>
        }
    </text>;

    blocks[ProfileSections.Maps] = @<section class="profile-section" id="maps" data-section-id="@ProfileSections.Maps">
        <div class="profile-section__head">
            <h2>Maps</h2>
            <partial name="_SectionHandle" model='new SectionHandle(owner, "Maps")' />
        </div>
        @if (Model.Maps.Count == 0)
        {
            <p class="profile-empty muted">No maps uploaded yet.</p>
        }
        else
        {
            <div class="card-grid">
                @foreach (var set in Model.Maps)
                {
                    <partial name="_BeatmapsetCard" model="set" />
                }
            </div>
            @if (Model.HasMoreMaps)
            {
                <div class="show-more">
                    <a class="btn btn-ghost" href="/beatmapsets?q=@Uri.EscapeDataString(Model.ProfileUser.Username)">show all maps</a>
                </div>
            }
        }
    </section>;

    blocks[ProfileSections.Favourites] = @<section class="profile-section" id="favourites" data-section-id="@ProfileSections.Favourites">
        <div class="profile-section__head">
            <h2>Favourites</h2>
            <partial name="_SectionHandle" model='new SectionHandle(owner, "Favourites")' />
        </div>
        @if (Model.Favourites.Count == 0)
        {
            <p class="profile-empty muted">No favourites yet.</p>
        }
        else
        {
            <div class="card-grid">
                @foreach (var set in Model.Favourites)
                {
                    <partial name="_BeatmapsetCard" model="set" />
                }
            </div>
            @if (Model.HasMoreFavourites)
            {
                <p class="profile-empty faint">Showing the latest @Model.Favourites.Count favourites.</p>
            }
        }
    </section>;
}

<div class="profile-grid">
    <div class="profile-main" data-profile-sections>
        @if (owner)
        {
            @* The persist path, owner-only. The form is never submitted as a form (there is no
               no-JS ordering story: you cannot drag without a pointer), it exists so the fetch in
               profile-reorder.js can lift a real antiforgery token and a real handler URL out of
               it, exactly like the follow/favourite toggles do. Its presence is also what tells
               the script this visitor is the owner. *@
            <form class="js-reorder-form" method="post" asp-page="/Users/Profile"
                  asp-route-idOrName="@Model.ProfileUser.Id" asp-page-handler="Reorder" hidden></form>
            @* Empty and hidden until something goes wrong: a failed persist rewinds the DOM and
               says so here, since a silently-reverted drag would read as the page being broken. *@
            <p class="profile-reorder-status" data-reorder-status role="status" aria-live="polite" hidden></p>
        }

        @foreach (string sectionId in Model.SectionOrder)
        {
            @* An id with no block cannot happen (SectionOrder is filtered to known ids), but the
               loop refuses to guess rather than throwing on a stored array from the future. *@
            if (blocks.TryGetValue(sectionId, out var block))
            {
                @block(null)
            }
        }
    </div>

    <aside class="profile-side">
        <div class="card profile-stats">
            <h3 class="card-title">Player stats</h3>
            @* Two ranks, one per /rankings board. The headline is the PERFORMANCE one, because that
               is the site's main ranking; the score board's rank is a labelled stat row directly
               above the score it is computed from. Each rank sits with its own metric, and neither
               is unlabelled, so "#3" can never be read as the other board's. *@
            <div class="profile-rank">
                <span class="profile-rank__label">Performance rank</span>
                <span class="profile-rank__value">@(Model.PpRank is long ppRank ? "#" + ppRank.ToString("N0", CultureInfo.InvariantCulture) : "Unranked")</span>
                <span class="profile-rank__pp" title="total performance points; your best play on each ranked song, weighted">@Model.TotalPp.ToString("N0", CultureInfo.InvariantCulture)pp</span>
            </div>
            <div class="stat-row"><span class="stat-row__label">Score rank</span><span class="stat-row__value">@(Model.GlobalRank is long rank ? "#" + rank.ToString("N0", CultureInfo.InvariantCulture) : "Unranked")</span></div>
            <div class="stat-row"><span class="stat-row__label">Ranked score</span><span class="stat-row__value">@Model.RankedScore.ToString("N0", CultureInfo.InvariantCulture)</span></div>
            <div class="stat-row"><span class="stat-row__label">Total score</span><span class="stat-row__value">@Model.TotalScore.ToString("N0", CultureInfo.InvariantCulture)</span></div>
            <div class="stat-row"><span class="stat-row__label">Play count</span><span class="stat-row__value">@Model.PlayCount.ToString("N0", CultureInfo.InvariantCulture)</span></div>
            <div class="stat-row"><span class="stat-row__label">Maps played</span><span class="stat-row__value">@Model.MapsPlayed.ToString("N0", CultureInfo.InvariantCulture) / @Model.RankedMapPool.ToString("N0", CultureInfo.InvariantCulture) ranked</span></div>
            <div class="stat-row"><span class="stat-row__label">First places</span><span class="stat-row__value">@Model.FirstPlaceCount.ToString("N0", CultureInfo.InvariantCulture)</span></div>
            <div class="stat-row" title="how many times other players watched this player's replays; their own downloads never count"><span class="stat-row__label">Replays watched by others</span><span class="stat-row__value">@Model.ReplayViewCount.ToString("N0", CultureInfo.InvariantCulture)</span></div>
            <div class="stat-row"><span class="stat-row__label">Play time</span><span class="stat-row__value">@ProfileModel.FormatPlayTime(Model.PlayTimeS)</span></div>
            <div class="stat-row"><span class="stat-row__label">Accuracy</span><span class="stat-row__value">@(Model.Accuracy is double acc ? (acc * 100).ToString("0.00", CultureInfo.InvariantCulture) + "%" : "-")</span></div>
            <div class="grade-counts" title="per-map best grades">
                <div class="grade-count"><span class="grade grade--ss">SS</span><span class="grade-count__num">@Model.Grades.Ss</span></div>
                <div class="grade-count"><span class="grade grade--s">S</span><span class="grade-count__num">@Model.Grades.S</span></div>
                <div class="grade-count"><span class="grade grade--a">A</span><span class="grade-count__num">@Model.Grades.A</span></div>
                <div class="grade-count"><span class="grade grade--b">B</span><span class="grade-count__num">@Model.Grades.B</span></div>
                <div class="grade-count"><span class="grade grade--c">C</span><span class="grade-count__num">@Model.Grades.C</span></div>
                <div class="grade-count"><span class="grade grade--d">D</span><span class="grade-count__num">@Model.Grades.D</span></div>
            </div>
        </div>
    </aside>
</div>

@if (owner)
{
    @* Owner-only, and page-local rather than in _Layout: nobody else's profile has anything for
       it to wire, and no other page has sections at all. Loaded like Play/Index.cshtml loads its
       own scripts. *@
    <script src="~/js/profile-reorder.js" asp-append-version="true" defer></script>
}
