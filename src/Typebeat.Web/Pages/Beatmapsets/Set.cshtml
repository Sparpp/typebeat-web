@page "/beatmapsets/{id:long}"
@using System.Globalization
@model Typebeat.Web.Pages.Beatmapsets.SetModel

@{
    string? coverStyle = Model.Set.CoverUrl is null ? null : $"background-image:url('{Model.Set.CoverUrl}')";
    bool preferOriginal = Model.CurrentUser?.PreferOriginalMetadata ?? false;
    string displayTitle = Model.Set.DisplayTitle(preferOriginal);
    string displayArtist = Model.Set.DisplayArtist(preferOriginal);

    // The handler refuses a reviewer's own set (OnPostRank/OnPostUnrank 404 it, admins exempt),
    // so the strip must not offer a button that cannot work. The guard is the boundary; this is
    // just honesty about it.
    bool canReview = Model.CurrentUser?.CanReviewMaps == true
                     && (Model.CurrentUser.IsAdmin || Model.CurrentUser.Id != Model.Set.OwnerId);
}
<section class="set-header @(Model.Set.CoverUrl is null ? "set-header--nocover" : "")" style="@coverStyle">
    <div class="set-header__scrim">
        <div class="set-header__main">
            <div class="set-header__badges">
                <span class="pill @Model.Set.PillClass">@Model.Set.StatusLabel</span>
                <span class="set-header__counter" title="play count"><span aria-hidden="true">&#9654;</span> @Model.Set.PlayCount.ToString("N0", CultureInfo.InvariantCulture)</span>
                <span class="set-header__counter" title="favourites"><span aria-hidden="true">&#9825;</span> @Model.Set.FavouriteCount.ToString("N0", CultureInfo.InvariantCulture)</span>
                <span class="set-header__counter" title="downloads"><span aria-hidden="true">&#8595;</span> @Model.Set.DownloadCount.ToString("N0", CultureInfo.InvariantCulture)</span>
            </div>
            <h1 class="set-header__title">
                @displayTitle
                @if (Model.Set.Explicit)
                {
                    <partial name="_ExplicitBadge" />
                }
            </h1>
            <div class="set-header__artist">by @displayArtist</div>
            <div class="set-header__mapper">
                mapped by <a href="/users/@Model.Set.OwnerId">@Model.Set.Creator</a>
            </div>
            <div class="set-header__dates faint">
                submitted @Model.Set.SubmittedAt.ToString("d MMM yyyy", CultureInfo.InvariantCulture)
                &middot; updated @Model.Set.UpdatedAt.ToString("d MMM yyyy", CultureInfo.InvariantCulture)
            </div>
            <div class="set-header__actions">
                @if (Model.Set.HasPackage)
                {
                    <a class="btn btn-primary btn-big" href="/beatmapsets/@Model.Set.Id/download">Download</a>
                }
                else
                {
                    @* Pre-M3 set: live diffs but no uploaded package, a Download link would 404. *@
                    <span class="btn btn-ghost btn-big btn-unavailable"
                          title="This map predates website downloads, grab it from the in-game listing.">
                        available in-game only
                    </span>
                }
                @if (Model.CurrentUser is not null)
                {
                    <form method="post" asp-page-handler="Favourite" asp-route-id="@Model.Set.Id">
                        <button type="submit" class="btn btn-ghost fav-btn @(Model.Set.IsFavourited ? "is-on" : "")">
                            @(Model.Set.IsFavourited ? "♥ Favourited" : "♡ Favourite")
                        </button>
                    </form>
                }
                else
                {
                    <a class="btn btn-ghost" href="/login" title="Sign in to favourite">&#9825; Favourite</a>
                }
                @if (Model.Set.PreviewUrl is not null)
                {
                    <button type="button" class="preview-btn preview-btn--big" data-preview="@Model.Set.PreviewUrl"
                            aria-label="Play preview"></button>
                }
            </div>
            @if (canReview && Model.Set.Status is "pending" or "ranked")
            {
                @* Reviewer-only strip, deliberately set apart from the player actions above. *@
                <div class="review-controls">
                    <span class="review-controls__label">map review</span>
                    @if (Model.Set.Status == "pending")
                    {
                        <form method="post" asp-page-handler="Rank" asp-route-id="@Model.Set.Id">
                            <button type="submit" class="btn btn-ghost btn-small">Rank this map</button>
                        </form>
                    }
                    else
                    {
                        <form method="post" asp-page-handler="Unrank" asp-route-id="@Model.Set.Id">
                            <button type="submit" class="btn btn-danger btn-small">Unrank</button>
                        </form>
                    }
                </div>
            }
            <details class="report-box" @(Model.Reported ? "open" : null)>
                <summary>Report this beatmap</summary>
                @if (Model.Reported)
                {
                    <p class="report-box__thanks">Thanks, your report is in. A human will look at it.</p>
                }
                else
                {
                    <form method="post" asp-page-handler="Report" asp-route-id="@Model.Set.Id">
                        <div class="field">
                            <label for="report-reason">What's wrong with it?</label>
                            <textarea class="input" id="report-reason" name="reason" rows="3" required
                                      maxlength="4000" placeholder="stolen map, broken timing, rule-breaking content&hellip;"></textarea>
                        </div>
                        <button type="submit" class="btn btn-ghost btn-small">Send report</button>
                    </form>
                }
            </details>
        </div>
        <aside class="set-stats">
            @* The two tabs are RADIO INPUTS, and the panels below are both rendered server-side:
               the whole toggle is one :checked sibling rule in site.css, so it costs no script and
               keeps working with JavaScript off. Stats is checked, so that is what everyone lands
               on; the inputs are visually hidden but still focusable, so the pair is reachable by
               keyboard as the radio group it actually is. *@
            @if (Model.Diff is not null)
            {
                <input class="stat-tab__radio" type="radio" name="set-stats-tab" id="set-stats-tab-stats" checked />
                <input class="stat-tab__radio" type="radio" name="set-stats-tab" id="set-stats-tab-pace" />
            }
            <div class="set-stats__head">
                <h3 class="card-title">Map stats</h3>
                @if (Model.Diff is not null)
                {
                    <div class="stat-tabs">
                        <label class="stat-tab stat-tab--stats" for="set-stats-tab-stats">Stats</label>
                        <label class="stat-tab stat-tab--pace" for="set-stats-tab-pace">WPM</label>
                    </div>
                }
            </div>
            @if (Model.Diffs.Count > 1)
            {
                @* Difficulty selector, one pill per difficulty, coloured by rating; the selected
                   one drives the stats box + leaderboard below (server re-renders on ?diff=). *@
                <div class="diff-selector">
                    @foreach (var d in Model.Diffs)
                    {
                        <a class="diff-pill @(d.Id == Model.Diff?.Id ? "is-on" : "")"
                           href="/beatmapsets/@Model.Set.Id?diff=@d.Id"
                           style="--diff-colour:@Typebeat.Web.DifficultyColour.ForStars(d.Stars)"
                           title="@d.Name">
                            <span class="diff-pill__star">&#9733; @d.Stars.ToString("0.0#", CultureInfo.InvariantCulture)</span>
                            <span class="diff-pill__name">@d.Name</span>
                        </a>
                    }
                </div>
            }
            @if (Model.Diff is not null)
            {
                <div class="stat-panel stat-panel--stats">
                    <div class="stat-row"><span class="stat-row__label">Length</span><span class="stat-row__value">@SetModel.FormatLength(Model.Diff.TotalLengthS)</span></div>
                    @if (Model.Diff.WordCount is int words)
                    {
                        <div class="stat-row"><span class="stat-row__label">Words</span><span class="stat-row__value">@words.ToString("N0", CultureInfo.InvariantCulture)</span></div>
                    }
                    @if (Model.Diff.CharCount is int chars)
                    {
                        <div class="stat-row"><span class="stat-row__label">Characters</span><span class="stat-row__value">@chars.ToString("N0", CultureInfo.InvariantCulture)</span></div>
                    }
                    @* Peak, then target, then average: one unit, three readings, hardest first. The
                       fastest stretch the map ever asks for; the average WPM across the fastest
                       fifth of its lyric lines, which is the one worth aiming at; and what it asks
                       on the whole. Peak is missing on any row the v11 backfill has not reached,
                       target on any the v18 one has not. *@
                    @if (Model.Diff.PeakWpm is double peakWpm)
                    {
                        <div class="stat-row"><span class="stat-row__label">Peak WPM</span><span class="stat-row__value">@peakWpm.ToString("0", CultureInfo.InvariantCulture)</span></div>
                    }
                    @if (Model.Diff.TargetWpm is double targetWpm)
                    {
                        <div class="stat-row"><span class="stat-row__label">Target WPM</span><span class="stat-row__value">@targetWpm.ToString("0", CultureInfo.InvariantCulture)</span></div>
                    }
                    @if (Model.Diff.Wpm is double averageWpm)
                    {
                        <div class="stat-row"><span class="stat-row__label">Average WPM</span><span class="stat-row__value">@averageWpm.ToString("0", CultureInfo.InvariantCulture)</span></div>
                    }
                    @* Directly under Average WPM because it is what makes that number readable: a
                       WPM here is CPM/5 flat, so this says how far the map's own words are from the
                       5 the unit assumes. One decimal is not decoration: the shipped maps measure
                       4.11 to 4.57 cells per word, so whole-character rounding would print "4" for
                       every one of them and the row would carry no information at all. Same label
                       and same format as the game's song-select wedge, so the two clients read
                       identically. *@
                    @if (Model.Diff.AverageCharsPerWord is double charsPerWord)
                    {
                        <div class="stat-row"><span class="stat-row__label">Chars/word</span><span class="stat-row__value">@charsPerWord.ToString("0.0", CultureInfo.InvariantCulture)</span></div>
                    }
                    <div class="stat-row">
                        <span class="stat-row__label">Stars</span>
                        <span class="stat-row__value" style="color:@DifficultyColour.ForStars(Model.Diff.Stars)">&#9733; @Model.Diff.Stars.ToString("0.0#", CultureInfo.InvariantCulture)</span>
                    </div>
                    <div class="meter" role="img" aria-label="difficulty @Model.Diff.Stars.ToString("0.0#", CultureInfo.InvariantCulture) of 10 stars">
                        <div class="meter__fill" style="width:@Math.Clamp(Model.Diff.Stars / 10 * 100, 0, 100).ToString("0.#", CultureInfo.InvariantCulture)%;background:@DifficultyColour.ForStars(Model.Diff.Stars)"></div>
                    </div>
                </div>
                <div class="stat-panel stat-panel--pace">
                    @if (Model.Diff.HasPaceCurve)
                    {
                        @* CSS bars, not an SVG: this panel is 240 px wide and the curve is 100
                           points, so every bar is about two pixels and any axis text an SVG
                           viewBox scaled down to fit would print is too small to read. Same
                           colour, peak emphasis and hover-title idiom as the shared bar chart. *@
                        <div class="wpm-graph" role="img"
                             aria-label="typing pace across the map, peaking at @(Model.Diff.PeakWpm?.ToString("0", CultureInfo.InvariantCulture)) WPM">
                            @foreach (var bar in Model.Diff.PaceBars)
                            {
                                if (bar.IsEmpty)
                                {
                                    <span class="wpm-graph__bar is-empty" title="@bar.Label"></span>
                                }
                                else
                                {
                                    <span class="wpm-graph__bar @(bar.IsPeak ? "is-peak" : "")" style="height:@bar.HeightCss" title="@bar.Label"></span>
                                }
                            }
                        </div>
                        <div class="wpm-graph__axis faint"><span>first word</span><span>last word</span></div>
                        @if (Model.Diff.PeakWpm is double graphPeak)
                        {
                            <div class="stat-row"><span class="stat-row__label">Peak WPM</span><span class="stat-row__value">@graphPeak.ToString("0", CultureInfo.InvariantCulture)</span></div>
                        }
                        @if (Model.Diff.TargetWpm is double graphTarget)
                        {
                            <div class="stat-row"><span class="stat-row__label">Target WPM</span><span class="stat-row__value">@graphTarget.ToString("0", CultureInfo.InvariantCulture)</span></div>
                        }
                        @if (Model.Diff.Wpm is double avgWpm)
                        {
                            <div class="stat-row"><span class="stat-row__label">Average WPM</span><span class="stat-row__value">@avgWpm.ToString("0", CultureInfo.InvariantCulture)</span></div>
                        }
                        @if (Model.Diff.AverageCharsPerWord is double paceCharsPerWord)
                        {
                            <div class="stat-row"><span class="stat-row__label">Chars/word</span><span class="stat-row__value">@paceCharsPerWord.ToString("0.0", CultureInfo.InvariantCulture)</span></div>
                        }
                        <p class="wpm-graph__caption faint">
                            Rolling 30-keystroke pace, from the first typed character to the last.
                            A word is five keystrokes here, the typing-test convention, and the row
                            above says how long this map's own words actually run. Target is not off
                            this graph: it is the average WPM across the fastest fifth of the map's
                            lyric lines, so it is the pace to hold through the hard stretches rather
                            than the one window at the peak.
                        </p>
                    }
                    else
                    {
                        @* No curve: either this map predates the measurement and the startup
                           backfill has not reached it, or it is too short to measure at all. A note
                           in place of an empty plot, the same way the lyrics section hides itself. *@
                        <p class="muted">No pace graph for this difficulty yet.</p>
                    }
                </div>
            }
            else
            {
                <p class="muted">No difficulty data yet.</p>
            }
        </aside>
    </div>
</section>

<section class="set-body">
    @if (Model.Set.Description.Length > 0)
    {
        @* Plain text by design: default Razor encoding + pre-line = XSS-safe line breaks. *@
        <div class="set-description">@Model.Set.Description</div>
    }
    @if (Model.Set.TagList.Any() || Model.Set.Source.Length > 0 || Model.Set.LanguageDisplay is not null)
    {
        <div class="tag-chips">
            @if (Model.Set.Source.Length > 0)
            {
                <span class="chip"><span class="chip-label">source</span><span class="chip-value">@Model.Set.Source</span></span>
            }
            @* Links back into the listing with the operator that finds the rest of them. Rendered
               only when the set actually has a language (unset sets show nothing at all). *@
            @if (Model.Set.LanguageDisplay is string languageDisplay)
            {
                <a class="chip" href="/beatmapsets?q=@Uri.EscapeDataString($"language:{Model.Set.Language}")"><span class="chip-label">language</span><span class="chip-value">@languageDisplay</span></a>
            }
            @foreach (string tag in Model.Set.TagList)
            {
                <a class="pill pill--accent" href="/beatmapsets?q=@Uri.EscapeDataString(tag)">@tag</a>
            }
        </div>
    }
</section>

<section class="set-leaderboard">
    <div class="set-leaderboard__head">
        <h2>Leaderboard@(Model.Diffs.Count > 1 && Model.Diff is not null ? $": {Model.Diff.Name}" : "")</h2>
        @if (Model.Set.Status == "ranked" && Model.Diff is not null)
        {
            <div class="lb-tabs" role="tablist">
                <a class="lb-tab @(Model.Board == "ranked" ? "is-active" : "")" href="/beatmapsets/@Model.Set.Id?diff=@Model.Diff.Id&board=ranked">Ranked</a>
                <a class="lb-tab @(Model.Board == "unranked" ? "is-active" : "")" href="/beatmapsets/@Model.Set.Id?diff=@Model.Diff.Id&board=unranked">Unranked</a>
            </div>
        }
    </div>
    @if (Model.Set.Status == "unranked")
    {
        @* The creator marked this map not-for-ranking; it takes plays but will never rank. *@
        <div class="empty-state">
            <h3>Unranked</h3>
            <p>The creator marked this map as not intended for ranking, so it has no leaderboard.</p>
        </div>
    }
    else if (Model.Set.Status != "ranked")
    {
        @* Pending (and owner-viewed hidden/removed) sets take plays but rank nothing. *@
        <div class="empty-state">
            <h3>Not ranked yet</h3>
            <p>Leaderboard unlocks when this map is ranked.</p>
        </div>
    }
    else if (Model.Scores.Count == 0 && Model.Board == "unranked")
    {
        <div class="empty-state">
            <h3>No unranked scores</h3>
            <p>No completed play here used an unranked mod (Mashing, Wind Up/Down) or a non-default rate.</p>
        </div>
    }
    else if (Model.Scores.Count == 0)
    {
        <div class="empty-state">
            <h3>No scores yet</h3>
            <p>Nobody has typed this one, the #1 spot is wide open.</p>
        </div>
    }
    else
    {
        var top = Model.Scores[0];
        var anyTypos = Model.Scores.Any(s => s.Typos is not null);
        <div class="podium">
            <span class="podium__rank">#1</span>
            <a href="/users/@top.UserId" class="podium__avatar-link" aria-label="@top.Username">
                @if (top.AvatarUrl is string topAvatar)
                {
                    <img class="podium__avatar" src="@topAvatar" alt="" />
                }
                else
                {
                    <span class="avatar-fallback" aria-hidden="true">@top.Username[..1]</span>
                }
            </a>
            <div class="podium__who">
                <a class="podium__name" href="/users/@top.UserId">@top.Username</a>
                <div class="faint">@top.EndedAt.ToString("d MMM yyyy", CultureInfo.InvariantCulture)</div>
            </div>
            <div class="podium__stats">
                <div class="podium-stat"><span class="podium-stat__label">Total score</span><span class="podium-stat__value">@top.TotalScore.ToString("N0", CultureInfo.InvariantCulture)</span></div>
                <div class="podium-stat"><span class="podium-stat__label">Completion</span><span class="podium-stat__value">@SetModel.FormatPercent(top.Completion)</span></div>
                <div class="podium-stat"><span class="podium-stat__label">Accuracy</span><span class="podium-stat__value">@SetModel.FormatPercent(top.Accuracy)</span></div>
                <div class="podium-stat"><span class="podium-stat__label">Max combo</span><span class="podium-stat__value">@top.MaxCombo.ToString("N0", CultureInfo.InvariantCulture)x</span></div>
                <div class="podium-stat"><span class="podium-stat__label">Great</span><span class="podium-stat__value">@top.Great</span></div>
                <div class="podium-stat"><span class="podium-stat__label">Ok</span><span class="podium-stat__value">@top.Ok</span></div>
                <div class="podium-stat"><span class="podium-stat__label">Meh</span><span class="podium-stat__value">@top.Meh</span></div>
                @* Miss and Typos are both blank at zero (and both absent from a clean play's
                   statistics), so neither shows a fabricated 0 beside the other's empty cell. *@
                @if (top.Miss is int topMiss)
                {
                    <div class="podium-stat"><span class="podium-stat__label">Miss</span><span class="podium-stat__value">@topMiss</span></div>
                }
                @* Only for a play that CARRIES the stat; a score from before it existed shows no
                   cell at all rather than a fabricated 0. *@
                @if (top.Typos is int topTypos)
                {
                    <div class="podium-stat"><span class="podium-stat__label">Typos</span><span class="podium-stat__value">@topTypos</span></div>
                }
                <div class="podium-stat"><span class="podium-stat__label">Grade</span><span class="podium-stat__value grade @SetModel.GradeClass(top.Rank)">@SetModel.GradeLabel(top.Rank)</span></div>
                @if (top.Mods.Count > 0)
                {
                    <div class="podium-stat"><span class="podium-stat__label">Mods</span><span class="podium-stat__value"><partial name="_ModIcons" model="top.Mods" /></span></div>
                }
            </div>
        </div>

        <div class="table-wrap">
            <table class="table">
                <thead>
                <tr>
                    <th>Rank</th>
                    <th>Grade</th>
                    <th>Completion</th>
                    <th>Score</th>
                    <th>Accuracy</th>
                    <th>Player</th>
                    <th>Combo</th>
                    <th>Great</th>
                    <th>Ok</th>
                    <th>Meh</th>
                    <th>Miss</th>
                    @* The column appears only once some play on this board carries the stat; rows
                       that predate it leave their cell blank rather than claiming a clean run. *@
                    @if (anyTypos)
                    {
                        <th>Typos</th>
                    }
                    <th>Date</th>
                    <th>Mods</th>
                    <th>Replay</th>
                </tr>
                </thead>
                <tbody>
                @for (int i = 0; i < Model.Scores.Count; i++)
                {
                    var score = Model.Scores[i];
                    <tr>
                        <td class="num">#@(i + 1)</td>
                        <td><span class="grade @SetModel.GradeClass(score.Rank)">@SetModel.GradeLabel(score.Rank)</span></td>
                        <td class="num">@SetModel.FormatPercent(score.Completion)</td>
                        <td class="num">@score.TotalScore.ToString("N0", CultureInfo.InvariantCulture)</td>
                        <td class="num">@SetModel.FormatPercent(score.Accuracy)</td>
                        <td><a href="/users/@score.UserId">@score.Username</a></td>
                        <td class="num">@score.MaxCombo.ToString("N0", CultureInfo.InvariantCulture)x</td>
                        <td class="num">@score.Great</td>
                        <td class="num">@score.Ok</td>
                        <td class="num">@score.Meh</td>
                        @* Both blank at zero and a number otherwise. *@
                        <td class="num">@(score.Miss?.ToString(CultureInfo.InvariantCulture) ?? string.Empty)</td>
                        @if (anyTypos)
                        {
                            <td class="num">@(score.Typos?.ToString(CultureInfo.InvariantCulture) ?? string.Empty)</td>
                        }
                        <td>@score.EndedAt.ToString("d MMM yyyy", CultureInfo.InvariantCulture)</td>
                        <td><partial name="_ModIcons" model="score.Mods" /></td>
                        @* Only rows whose player uploaded a replay offer the download; the file
                           is a legacy .osr the game client opens. *@
                        <td>
                            @if (score.HasReplay)
                            {
                                <a href="/api/v2/scores/@score.ScoreId/replay" title="Download this replay (.osr)">Download</a>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

@if (Model.Diff is not null && Model.Diff.Lyrics.Length > 0)
{
    @* The selected difficulty's stored lyric text (?diff= re-renders, same as the stats box
       and leaderboard above). Same plain-text discipline as the description: default Razor
       encoding + pre-line = XSS-safe line breaks, one stored lyric line per rendered line.
       An empty string (blank map, or the backfill has not reached it) hides the section. *@
    <section class="set-lyrics">
        <h2>Lyrics@(Model.Diffs.Count > 1 ? $": {Model.Diff.Name}" : "")</h2>
        <div class="set-lyrics__text">@Model.Diff.Lyrics</div>
    </section>
}
