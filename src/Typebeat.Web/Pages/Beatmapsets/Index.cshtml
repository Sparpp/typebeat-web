@page "/beatmapsets"
@model Typebeat.Web.Pages.Beatmapsets.ListingModel
@{
    ViewData["Title"] = "Beatmaps";
    ViewData["MetaDescription"] = "Browse and download lyric-typing beatmaps for type!beat, "
        + "search by title, artist, mapper or tags.";
}

<h1>Beatmaps</h1>

<form method="get" action="/beatmapsets" class="listing-search" role="search">
    <input class="input" type="search" name="q" value="@Model.Query"
           placeholder="search: try title, artist, or star:&gt;4 length:&lt;2:00&hellip;"
           aria-label="Search beatmaps" aria-describedby="search-info-tip search-guide" />
    <span class="search-info">
        <button type="button" class="search-info__trigger" aria-label="How to search"
                aria-describedby="search-info-tip">
            <span aria-hidden="true">&#9432;</span>
        </button>
        <span class="search-info__tip" role="tooltip" id="search-info-tip">
            <p>Type filters right in the box as <code>key:value</code>. Stack several and they all
                have to match. Plain words search title, artist and mapper.</p>
            <p>
                <code>star:&gt;4</code> &nbsp; <code>wpm:&gt;120</code> &nbsp;
                <code>length:&lt;2:30</code> &nbsp; <code>creator:neon</code> &nbsp;
                <code>bpm:120-140</code> &nbsp; <code>lyrics:love</code> &nbsp;
                <code>lang:japanese</code>
            </p>
            <p>Numbers take <code>&gt;</code> <code>&lt;</code> or a <code>4-6</code> range;
                <code>length</code> also reads <code>mm:ss</code>. Full list in the guide below.</p>
        </span>
    </span>
    @if (Model.Sort != "newest")
    {
        <input type="hidden" name="s" value="@Model.Sort" />
    }
    @if (Model.StatusFilter != "any")
    {
        <input type="hidden" name="status" value="@Model.StatusFilter" />
    }
    @if (Model.Unplayed)
    {
        <input type="hidden" name="unplayed" value="true" />
    }
    <button type="submit" class="btn btn-primary">Search</button>
</form>

<details class="search-guide" id="search-guide">
    <summary>Search filters: type <code>key:value</code> right in the box</summary>
    <div class="search-guide__body">
        <p>
            Mix filters with normal words. Wrap values with spaces in quotes
            (<code>title:"night drive"</code>). Numbers take <code>&gt;</code>, <code>&lt;</code>,
            <code>&gt;=</code>, <code>&lt;=</code> or a <code>4-6</code> range. Unknown filters are
            treated as plain text.
        </p>
        <table class="search-guide__table">
            <tbody>
                <tr><td><code>title:</code></td><td>set title</td><td><code>title:rhapsody</code></td></tr>
                <tr><td><code>artist:</code></td><td>track artist</td><td><code>artist:"daft punk"</code></td></tr>
                <tr><td><code>creator:</code></td><td>mapper (also <code>mapper:</code>)</td><td><code>creator:neon</code></td></tr>
                <tr><td><code>source:</code></td><td>source</td><td><code>source:anime</code></td></tr>
                <tr><td><code>tag:</code></td><td>tags</td><td><code>tag:vocaloid</code></td></tr>
                <tr><td><code>lyrics:</code></td><td>words sung in the map; every word must appear</td><td><code>lyrics:"neon night"</code></td></tr>
                <tr><td><code>language:</code></td><td>song language (also <code>lang:</code>); takes short codes too</td><td><code>lang:jp</code></td></tr>
                <tr><td><code>star:</code></td><td>difficulty stars</td><td><code>star:4-6</code></td></tr>
                <tr><td><code>target:</code></td><td>target WPM: the average pace of the fastest fifth of the map's lyric lines</td><td><code>target:&gt;120</code></td></tr>
                <tr><td><code>wpm:</code></td><td>average words per minute, five keystrokes to the word</td><td><code>wpm:&gt;120</code></td></tr>
                <tr><td><code>cpm:</code></td><td>the same stored average in characters, exactly five times <code>wpm:</code>; no longer shown on pages</td><td><code>cpm:&gt;600</code></td></tr>
                <tr><td><code>length:</code></td><td>seconds, or <code>mm:ss</code></td><td><code>length:&gt;1:30</code></td></tr>
                <tr><td><code>bpm:</code></td><td>beats per minute</td><td><code>bpm:120-140</code></td></tr>
                <tr><td><code>date:</code></td><td>submitted (year / month / day)</td><td><code>date:&gt;2026-01-01</code></td></tr>
                <tr><td><code>explicit:</code></td><td>explicit content, yes or no (also <code>nsfw:</code>)</td><td><code>explicit:no</code></td></tr>
            </tbody>
        </table>
    </div>
</details>

<div class="listing-filters">
    <div class="filter-row">
        <span class="filter-label">Status</span>
        <a class="filter-pill @(Model.StatusFilter == "any" ? "is-active" : "")" href="@Model.BuildUrl(status: "any")">Any</a>
        <a class="filter-pill @(Model.StatusFilter == "ranked" ? "is-active" : "")" href="@Model.BuildUrl(status: "ranked")">Ranked</a>
        <a class="filter-pill @(Model.StatusFilter == "pending" ? "is-active" : "")" href="@Model.BuildUrl(status: "pending")">Pending</a>
        <a class="filter-pill @(Model.StatusFilter == "unranked" ? "is-active" : "")" href="@Model.BuildUrl(status: "unranked")">Unranked</a>
    </div>
    <div class="filter-row">
        <span class="filter-label">Sort</span>
        <a class="filter-pill @(Model.Sort == "newest" ? "is-active" : "")" href="@Model.BuildUrl(sort: "newest")">Newest</a>
        <a class="filter-pill @(Model.Sort == "plays" ? "is-active" : "")" href="@Model.BuildUrl(sort: "plays")">Most played</a>
        <a class="filter-pill @(Model.Sort == "favs" ? "is-active" : "")" href="@Model.BuildUrl(sort: "favs")">Most favourited</a>
    </div>
    @if (Model.CanFilterUnplayed)
    {
        <div class="filter-row">
            <span class="filter-label">Show</span>
            <a class="filter-pill @(Model.Unplayed ? "is-active" : "")" href="@Model.BuildUrl(unplayed: !Model.Unplayed)">Unplayed only</a>
        </div>
    }
</div>

@if (Model.Sets.Count > 0)
{
    <div class="card-grid">
        @foreach (var set in Model.Sets)
        {
            <partial name="_BeatmapsetCard" model="set" />
        }
    </div>

    @if (Model.NextPageUrl is not null)
    {
        <div class="show-more">
            <a class="btn btn-ghost" href="@Model.NextPageUrl">show more</a>
        </div>
    }
}
else
{
    <div class="empty-state">
        <h3>&hellip;and the crowd goes silent.</h3>
        <p>
            No maps matched that.
            @if (Model.Query.Length > 0)
            {
                <text>Try fewer words, or </text><a href="/beatmapsets">browse everything</a><text>.</text>
            }
            else
            {
                <text>Fire up the in-game editor and put the first one on stage.</text>
            }
        </p>
    </div>
}
