@page "/download/{handler?}"
@model DownloadModel
@{
    ViewData["Title"] = "Download";
    ViewData["MetaDescription"] = "Get type!beat for Windows — the free rhythm game "
        + "where the lyrics are the notes and your keyboard is the instrument.";
}

<section class="hero download-hero">
    <h1 class="hero-title">let's get you <span class="grad-text">typing</span>.</h1>
    @if (Model.Available)
    {
        <p class="hero-sub">One zip, no installer drama: extract, run, type.</p>
        <div class="hero-actions">
            <a class="btn btn-primary btn-big" href="/download/game" download>Download for Windows</a>
        </div>
        <p class="hero-note">@Model.FileName &middot; @Model.SizeDisplay &middot; Windows 10+ &middot; other platforms later</p>
    }
    else
    {
        <p class="hero-sub">The Windows build is <strong>coming soon</strong> &mdash; we're tuning the last few notes.</p>
        <div class="hero-actions">
            @if (Model.CurrentUser is null)
            {
                <a class="btn btn-primary btn-big" href="/register">Sign up</a>
            }
            <a class="btn btn-ghost btn-big" href="/beatmapsets">Browse beatmaps</a>
        </div>
        <p class="hero-note">Grab an account now and be ready on day one.</p>
    }
</section>

<section class="steps">
    <div class="step card">
        <div class="step__num">1</div>
        <h3>Download the game</h3>
        <p class="muted">Unzip anywhere and run <span class="faint">type!beat.exe</span>. No admin rights needed.</p>
    </div>
    <div class="step card">
        <div class="step__num">2</div>
        <h3>Create an account</h3>
        <p class="muted">In the game or <a href="/register">right here</a> &mdash; one account for both, and it puts your scores on the leaderboards.</p>
    </div>
    <div class="step card">
        <div class="step__num">3</div>
        <h3>Grab some maps</h3>
        <p class="muted"><a href="/beatmapsets">Browse the listing</a>, download a few songs, and type along.</p>
    </div>
</section>
