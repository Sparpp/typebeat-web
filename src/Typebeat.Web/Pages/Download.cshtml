@page "/download"
@model DownloadModel
@{
    ViewData["Title"] = "Download";
    ViewData["MetaDescription"] = "Get type!beat for Windows or Linux — the free rhythm game "
        + "where the lyrics are the notes and your keyboard is the instrument.";
}

<section class="hero download-hero">
    <h1 class="hero-title">let's get you <span class="grad-text">typing</span>.</h1>

    @if (Model.AnyAvailable)
    {
        <p class="hero-sub">Install, run, type. Your account and scores are shared with the web.</p>

        <div class="download-grid">
            <partial name="_DownloadCard" model="(Model.Windows, Model.DetectedOs)" />
            <partial name="_DownloadCard" model="(Model.Linux, Model.DetectedOs)" />
        </div>

        <p class="hero-note">Builds aren't code-signed yet, so Windows SmartScreen (or a Linux "allow to run" prompt) may warn on first launch.</p>
    }
    else
    {
        <p class="hero-sub">The desktop build is <strong>coming soon</strong> &mdash; we're tuning the last few notes.</p>
        <div class="hero-actions">
            @if (Model.CurrentUser is null)
            {
                <a class="btn btn-primary btn-big" href="/register">Sign up</a>
            }
            <a class="btn btn-ghost btn-big" href="/play">Play in browser</a>
        </div>
        <p class="hero-note">Grab an account now and be ready on day one.</p>
    }
</section>

<section class="steps">
    <div class="step card">
        <div class="step__num">1</div>
        <h3>Install &amp; run</h3>
        <p class="muted">Windows: run the installer. Linux: make the <span class="faint">.AppImage</span> executable and launch it. It auto-updates itself from here on.</p>
    </div>
    <div class="step card">
        <div class="step__num">2</div>
        <h3>Create an account</h3>
        <p class="muted">In the game or <a href="/register">right here</a> &mdash; one account for both, and it puts your scores on the leaderboards.</p>
    </div>
    <div class="step card">
        <div class="step__num">3</div>
        <h3>Grab some maps</h3>
        <p class="muted"><a href="/beatmapsets">Browse the listing</a>, download a few songs, and type along.</p>
    </div>
</section>
