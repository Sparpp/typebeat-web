@page "/download"
@model DownloadModel
@{
    ViewData["Title"] = "Download";
    ViewData["MetaDescription"] = "Get type!beat for Windows, macOS or Linux, the free rhythm game "
        + "where the lyrics are the notes and your keyboard is the instrument.";
    ViewData["JsonLd"] = Seo.VideoGameJsonLd(Seo.CanonicalUrl("/"), (string)ViewData["MetaDescription"]!);
}

<section class="hero download-hero">
    <h1 class="hero-title">let's get you <span class="grad-text">typing</span>.</h1>

    @if (Model.AnyAvailable)
    {
        @* Three cards in a two-column grid, so auto-placement puts macOS under Windows and leaves
           the slot under Linux empty: the trio reads as an L. Card order here IS the layout, do
           not reorder without re-checking .download-grid in site.css. *@
        <div class="download-grid">
            <partial name="_DownloadCard" model="(Model.Windows, Model.DetectedOs)" />
            <partial name="_DownloadCard" model="(Model.Linux, Model.DetectedOs)" />
            <partial name="_DownloadCard" model="(Model.Macos, Model.DetectedOs)" />
        </div>

        <p class="hero-note">Builds aren't code-signed yet, so your OS may warn on first launch.</p>
    }
    else
    {
        <p class="hero-sub">The desktop build is <strong>coming soon</strong>, we're tuning the last few notes.</p>
        <div class="hero-actions">
            @if (Model.CurrentUser is null)
            {
                <a class="btn btn-primary btn-big" href="/register">Sign up</a>
            }
            <a class="btn btn-ghost btn-big" href="/play">Play in browser</a>
        </div>
        <p class="hero-note">Grab an account now and be ready on day one.</p>
    }
</section>
