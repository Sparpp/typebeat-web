@page
@using System.Globalization
@model IndexModel
@{
    ViewData["MetaDescription"] = "type!beat is a free rhythm game played on your keyboard: "
        + "the lyrics are the notes. Download for Windows, macOS or Linux, grab community maps and chase the leaderboards.";
}

@if (Model.AccountDeleted)
{
    <div class="alert-info">Your account has been deleted. Thanks for playing.</div>
}

<section class="hero">
    <p class="hero-kicker">// built from osu!</p>
    <h1 class="hero-title">type to the b<span class="tail">eat</span></h1>
    <div class="hero-actions">
        <a class="btn btn-primary btn-big" href="/play">play in browser</a>
        @if (Model.GameDownloadAvailable)
        {
            <a class="btn btn-ghost btn-big" href="/download">download installer</a>
        }
        else if (Model.CurrentUser is null)
        {
            <a class="btn btn-ghost btn-big" href="/register">sign up</a>
        }
        @* Third CTA, in every hero variant: a full-basis wrapper takes a wrapped line of its own,
           so this sits centred UNDER the pair above and the three read as a triangle. *@
        <div class="hero-actions__under">
            <a class="btn btn-ghost btn-big" href="@SiteLinks.DISCORD_INVITE" target="_blank" rel="noopener">
                <svg class="hero-discord__mark" viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
                    <path d="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.0766.0766 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276 14.2924 14.2924 0 001.226-1.9942.076.076 0 00-.0416-.1057 13.1073 13.1073 0 01-1.8722-.8923.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.198.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.0766.0766 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189Z"/>
                </svg>
                <span>join discord</span>
            </a>
        </div>
    </div>
    @if (Model.GameDownloadAvailable)
    {
        <p class="hero-note">Builds aren't signed yet, so your OS may warn on first launch :(</p>
    }
    <p class="hero-stats">
        <span><strong>@Model.Players.ToString("N0", CultureInfo.InvariantCulture)</strong> registered players</span>
        <span><strong>@Model.ScoresTotal.ToString("N0", CultureInfo.InvariantCulture)</strong> scores</span>
        <span><strong>@Model.Maps.ToString("N0", CultureInfo.InvariantCulture)</strong> maps available</span>
    </p>
    <div class="hero-demo">
        <video class="hero-demo__video"
               src="~/media/widedemo.mp4"
               poster="~/media/widedemo-poster.jpg"
               autoplay muted loop playsinline preload="metadata" controls
               aria-label="type!beat gameplay demo">
        </video>
    </div>
</section>

<section class="landing-newest">
    <div class="landing-newest__head">
        <h2>newest maps</h2>
        <a class="btn btn-ghost btn-small" href="/beatmapsets">browse all maps</a>
    </div>
    @if (Model.NewestSets.Count > 0)
    {
        <div class="card-grid">
            @foreach (var set in Model.NewestSets)
            {
                <partial name="_BeatmapsetCard" model="set" />
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <h3>No maps yet</h3>
            <p>The stage is empty and the mic is live, fire up the in-game editor and submit the first one.</p>
        </div>
    }
</section>
