@page
@using System.Globalization
@model IndexModel
@{
    ViewData["MetaDescription"] = "type!beat is a free rhythm game played on your keyboard: "
        + "the lyrics are the notes. Download for Windows, grab community maps and chase the leaderboards.";
}

<section class="hero">
    <p class="hero-kicker">// the rhythm game for people who type</p>
    <h1 class="hero-title">type to the b<span class="caret caret--tall" aria-hidden="true"></span><span class="tail">eat</span></h1>
    <p class="hero-sub">
        The lyrics are the notes. They drop with the music &mdash; type every word on the grid, hold the combo, or watch it die in public.
    </p>
    <div class="hero-actions">
        <a class="btn btn-primary btn-big" href="/download">download &mdash; windows</a>
        @if (Model.CurrentUser is null)
        {
            <a class="btn btn-ghost btn-big" href="/register">sign up</a>
        }
        else
        {
            <a class="btn btn-ghost btn-big" href="/beatmapsets">browse maps</a>
        }
    </div>
    <p class="hero-note">free to play &middot; windows 10+ &middot; maps made by players, for players</p>
    <p class="hero-stats">
        <span><strong>@Model.Players.ToString("N0", CultureInfo.InvariantCulture)</strong> registered players</span>
        <span><strong>@Model.ScoresToday.ToString("N0", CultureInfo.InvariantCulture)</strong> scores today</span>
        <span><strong>@Model.Maps.ToString("N0", CultureInfo.InvariantCulture)</strong> maps available</span>
    </p>
</section>

<section class="landing-newest">
    <div class="landing-newest__head">
        <h2>newest maps</h2>
        <a class="btn btn-ghost btn-small" href="/beatmapsets">browse all maps</a>
    </div>
    @if (Model.NewestSets.Count > 0)
    {
        <div class="card-grid">
            @foreach (var set in Model.NewestSets)
            {
                <partial name="_BeatmapsetCard" model="set" />
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <h3>No maps yet</h3>
            <p>The stage is empty and the mic is live &mdash; fire up the in-game editor and submit the first one.</p>
        </div>
    }
</section>
