@{
    var sessionUser = Context.SessionUser();
    // A page may set the whole title (FullTitle, the landing's) instead of the usual Title, which
    // gets the " · type!beat" suffix.
    string fullTitle = ViewData["FullTitle"] as string
        ?? (ViewData["Title"] is string title ? $"{title} · type!beat" : "type!beat");
    string metaDescription = ViewData["MetaDescription"] as string
        ?? "type!beat: the free lyric-typing rhythm game. The words drop with the music; keep up with your keyboard.";

    // Search and share metadata (backlog 369). The canonical names typebeat.sh whatever host
    // served the page; a page whose path is not its preferred URL (a profile reached by name)
    // sets CanonicalPath. Pages under Seo.IsNoIndex get noindex and no canonical.
    bool noIndex = Seo.IsNoIndex(Context.Request.Path);
    string canonicalUrl = ViewData["CanonicalPath"] is string canonicalPath
        ? Seo.CanonicalUrl(canonicalPath)
        : Seo.CanonicalUrl(Context.Request.Path, Context.Request.Query);
    // Every page has a share image (its own, or the default), so every card is the large one.
    string shareImage = ViewData["OgImage"] as string ?? Seo.DEFAULT_OG_IMAGE;
    string? jsonLd = ViewData["JsonLd"] as string;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@fullTitle</title>
    <meta name="description" content="@metaDescription" />
    @if (noIndex)
    {
        <meta name="robots" content="noindex" />
    }
    else
    {
        <link rel="canonical" href="@canonicalUrl" />
    }
    <meta property="og:site_name" content="type!beat" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="@fullTitle" />
    <meta property="og:description" content="@metaDescription" />
    <meta property="og:url" content="@canonicalUrl" />
    <meta property="og:image" content="@shareImage" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@fullTitle" />
    <meta name="twitter:description" content="@metaDescription" />
    <meta name="twitter:image" content="@shareImage" />
    @if (jsonLd is not null)
    {
        @* Written raw as one string: as markup, the tag helpers would encode the "+" in the type
           attribute. The JSON is serialised by Seo with the default encoder (<, > and & escaped),
           so it cannot close the element early. *@
        @Html.Raw("<script type=\"application/ld+json\">" + jsonLd + "</script>")
    }
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    @* The one self-hosted font, fetched early instead of after the stylesheet is parsed. *@
    <link rel="preload" href="/fonts/jetbrainsmono-latin-wght.woff2" as="font" type="font/woff2" crossorigin />
    @if (ViewData["PreloadImage"] is string preloadImage)
    {
        @* The page's largest paint (the landing's demo poster), requested before the CSS is parsed. *@
        <link rel="preload" href="@preloadImage" as="image" />
    }
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="~/js/preview-player.js" asp-append-version="true" defer></script>
    <script src="~/js/favourite.js" asp-append-version="true" defer></script>
    <script src="~/js/card-download.js" asp-append-version="true" defer></script>
    <script src="~/js/card-diffs.js" asp-append-version="true" defer></script>
    <script src="~/js/follow.js" asp-append-version="true" defer></script>
    <script src="~/js/notifications.js" asp-append-version="true" defer></script>
</head>
<body>
<header class="site-nav">
    <nav class="container nav-inner">
        <a class="wordmark" href="/"><span class="caret" aria-hidden="true"></span>type<span class="bang">!</span>beat</a>
        <div class="nav-links">
            <a href="/play">play</a>
            <a href="/beatmapsets">beatmaps</a>
            <a href="/rankings">rankings</a>
            @* No "watching" tab here any more (task 70). The notifications page it pointed at is
               now reached from the bell in .nav-auth below, which is where a personal, unread-count
               surface belongs: the main nav is the site's public map, one entry per place anybody
               can go. *@
            <a href="/download">download</a>
        </div>
        <div class="nav-auth">
            @if (sessionUser is not null)
            {
                <partial name="_NotificationBell" />
                <a class="user-chip" href="/users/@sessionUser.Id">
                    @if (sessionUser.AvatarKey is string avatarKey)
                    {
                        <img class="user-chip__avatar" src="/@avatarKey" alt="" width="26" height="26" />
                    }
                    else
                    {
                        <span class="user-chip__avatar user-chip__avatar--fallback" aria-hidden="true">@sessionUser.Username[..1]</span>
                    }
                    <span class="user-chip__name">@sessionUser.Username</span>
                </a>
                <a class="btn btn-ghost btn-small" href="/settings">settings</a>
                <form method="post" action="/logout">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-ghost btn-small">sign out</button>
                </form>
            }
            else
            {
                <a class="btn btn-ghost btn-small" href="/login">sign in</a>
                <a class="btn btn-primary btn-small" href="/register">sign up</a>
            }
        </div>
    </nav>
</header>
<main class="site-main">
    <div class="container">
        @RenderBody()
    </div>
</main>
<footer class="site-footer">
    <div class="container footer-inner">
        <a href="@SiteLinks.DISCORD_INVITE">Discord</a>
        <a href="https://stats.uptimerobot.com/E7XRJ7vfer">Server status</a>
        <a href="@SiteLinks.SOURCE_REPOSITORY">Source</a>
        <a href="/legal/dmca">DMCA</a>
        <a href="/legal/privacy">Privacy</a>
        <span class="footer-copy">type!beat</span>
    </div>
</footer>
</body>
</html>
