@{
    var sessionUser = Context.SessionUser();
    string fullTitle = ViewData["Title"] is string title ? $"{title} · type!beat" : "type!beat";
    string metaDescription = ViewData["MetaDescription"] as string
        ?? "type!beat: the free lyric-typing rhythm game. The words drop with the music; keep up with your keyboard.";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@fullTitle</title>
    <meta name="description" content="@metaDescription" />
    <meta property="og:site_name" content="type!beat" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="@fullTitle" />
    <meta property="og:description" content="@metaDescription" />
    @if (ViewData["OgImage"] is string ogImage)
    {
        <meta property="og:image" content="@ogImage" />
    }
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="~/js/preview-player.js" asp-append-version="true" defer></script>
    <script src="~/js/favourite.js" asp-append-version="true" defer></script>
    <script src="~/js/card-download.js" asp-append-version="true" defer></script>
    <script src="~/js/card-diffs.js" asp-append-version="true" defer></script>
    <script src="~/js/follow.js" asp-append-version="true" defer></script>
    <script src="~/js/notifications.js" asp-append-version="true" defer></script>
</head>
<body>
<header class="site-nav">
    <nav class="container nav-inner">
        <a class="wordmark" href="/"><span class="caret" aria-hidden="true"></span>type<span class="bang">!</span>beat</a>
        <div class="nav-links">
            <a href="/play">play</a>
            <a href="/beatmapsets">beatmaps</a>
            <a href="/rankings">rankings</a>
            @* No "watching" tab here any more (task 70). The notifications page it pointed at is
               now reached from the bell in .nav-auth below, which is where a personal, unread-count
               surface belongs: the main nav is the site's public map, one entry per place anybody
               can go. *@
            <a href="/download">download</a>
        </div>
        <div class="nav-auth">
            @if (sessionUser is not null)
            {
                <partial name="_NotificationBell" />
                <a class="user-chip" href="/users/@sessionUser.Id">
                    @if (sessionUser.AvatarKey is string avatarKey)
                    {
                        <img class="user-chip__avatar" src="/@avatarKey" alt="" />
                    }
                    else
                    {
                        <span class="user-chip__avatar user-chip__avatar--fallback" aria-hidden="true">@sessionUser.Username[..1]</span>
                    }
                    <span class="user-chip__name">@sessionUser.Username</span>
                </a>
                <a class="btn btn-ghost btn-small" href="/settings">settings</a>
                <form method="post" action="/logout">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-ghost btn-small">sign out</button>
                </form>
            }
            else
            {
                <a class="btn btn-ghost btn-small" href="/login">sign in</a>
                <a class="btn btn-primary btn-small" href="/register">sign up</a>
            }
        </div>
    </nav>
</header>
<main class="site-main">
    <div class="container">
        @RenderBody()
    </div>
</main>
<footer class="site-footer">
    <div class="container footer-inner">
        <a href="@SiteLinks.DISCORD_INVITE">Discord</a>
        <a href="https://stats.uptimerobot.com/E7XRJ7vfer">Server status</a>
        <a href="https://github.com/Sparpp/typebeat">Source</a>
        <a href="/legal/dmca">DMCA</a>
        <a href="/legal/privacy">Privacy</a>
        <a href="/flags/NOTICE.txt" title="Country flags from Twemoji, CC-BY 4.0">Flags: Twemoji</a>
        <span class="footer-copy">type!beat</span>
    </div>
</footer>
</body>
</html>
