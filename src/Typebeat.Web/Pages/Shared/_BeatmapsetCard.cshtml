@using System.Globalization
@model BeatmapsetCardModel
@{
    // Where the favourite POST sends the user back to (listing page keeps its query string).
    string returnUrl = Context.Request.Path + Context.Request.QueryString;
    var sessionUser = Context.SessionUser();
    bool preferOriginal = sessionUser?.PreferOriginalMetadata ?? false;
    string displayTitle = Model.DisplayTitle(preferOriginal);
    string displayArtist = Model.DisplayArtist(preferOriginal);
    bool playMode = (ViewData["CardPlayMode"] as bool?) == true;
    // The webplay rail is a deep link INTO /play, so it would be circular on the picker itself
    // (there the whole rail already launches the player in place, without a navigation).
    bool showWebplay = Model.CanWebplay && !playMode;
    // Sets with a video get the two-option download instead of a plain link: the video is most of
    // the package's bytes, so "audio only" is the difference between a quick download and a long
    // one. Never in play mode, where the rail is the player's launch button and there is no
    // download control at all.
    bool showDownloadChoice = Model.OffersDownloadChoice && !playMode;
}
<article class="bset-card" data-set-id="@Model.Id">
    <div class="bset-card__media">
        @if (Model.CoverUrl is not null)
        {
            <img src="@Model.CoverUrl" alt="" loading="lazy" />
        }
        else
        {
            <div class="cover-fallback" aria-hidden="true"></div>
        }
        @if (Model.PreviewUrl is not null)
        {
            <button type="button" class="preview-btn" data-preview="@Model.PreviewUrl"
                    aria-label="Play preview"></button>
        }
    </div>
    <div class="bset-card__info">
        <span class="bset-card__titlerow">
            <a class="bset-card__title" href="/beatmapsets/@Model.Id" title="@displayTitle">@displayTitle</a>
            @if (Model.Explicit)
            {
                <partial name="_ExplicitBadge" />
            }
        </span>
        <span class="bset-card__artist" title="@displayArtist">by @displayArtist</span>
        <span class="bset-card__mapper">mapped by <a href="/users/@Model.OwnerId">@Model.Creator</a></span>
        <span class="bset-card__stats">
            <span title="play count"><span aria-hidden="true">&#9654;</span> @Model.PlayCount.ToString("N0", CultureInfo.InvariantCulture)</span>
            <span title="favourites"><span aria-hidden="true">&#9825;</span> <span data-fav-count>@Model.FavouriteCount.ToString("N0", CultureInfo.InvariantCulture)</span></span>
            <span title="submitted">@Model.Date.ToString("d MMM yyyy", CultureInfo.InvariantCulture)</span>
        </span>
        <span class="bset-card__meta">
            <span class="pill @Model.PillClass">@Model.StatusLabel</span>
            @if (Model.HasDiffStack)
            {
                @* Two or more live difficulties (backlog 327): the chip is a button that cycles
                   them, one star per difficulty (the StackCap hardest drawn), each in its own
                   colour, the current one on top. Everything visible is the TOP difficulty's own
                   rating and pace, hardest first, so the default reading pairs numbers from ONE
                   difficulty (the set-level max(stars) / max(wpm) can come from two). With JS off
                   the button does nothing and this is the whole story. card-diffs.js rotates it
                   from data-diffs, which carries every difficulty already formatted. *@
                var top = Model.Diffs[0];
                var stacked = Model.StackedDiffs;
                <button type="button" class="chip chip--diffs" data-diff-stack data-diffs="@Model.DiffsDataJson"
                        data-diff-index="0" aria-label="@BeatmapsetCardModel.DiffLabel(top, Model.Diffs.Count)"
                        style="--stack-n:@stacked.Count;--rating-ch:@Model.StarsTextWidth;--wpm-ch:@Model.WpmTextWidth">
                    <span class="chip-value" data-diff-colour style="color:@Typebeat.Web.DifficultyColour.ForStars(top.Stars)">
                        <span class="chip-stars" aria-hidden="true">
                            @for (int i = 0; i < stacked.Count; i++)
                            {
                                <span class="chip-star" data-diff-star style="--slot:@i;color:@Typebeat.Web.DifficultyColour.ForStars(stacked[i].Stars)">&#9733;</span>
                            }
                        </span>
                        <span class="chip-rating" data-diff-rating>@BeatmapsetCardModel.FormatStars(top.Stars)</span>
                    </span>
                    <span class="chip-label chip-wpm" data-diff-wpm
                          title="target words per minute: the average WPM across the fastest fifth of the map's lyric lines of three words or more">@(top.Wpm is double topWpm ? BeatmapsetCardModel.FormatWpm(topWpm) + " WPM" : "")</span>
                    @if (Model.HasPolyglot)
                    {
                        @* Backlog 332. Set-wide and static while the stack cycles: the per-difficulty
                           answer rides each difficulty's aria-label instead, which the script
                           already swaps, and the tooltip counts them. *@
                        <span class="chip-polyglot" data-polyglot-available title="@Model.PolyglotTitle" aria-hidden="true">PG</span>
                    }
                </button>
            }
            else
            {
            <span class="chip">
                <span class="chip-value" style="color:@Typebeat.Web.DifficultyColour.ForStars(Model.Stars)">&#9733; @Model.Stars.ToString("0.0#", CultureInfo.InvariantCulture)</span>
                @* No chars/word here: the card has one line for stars and pace, and the word length
                   is context for the WPM rather than a headline. The title says which WPM this is:
                   the TARGET pace since backlog 272, which is what a player wants off a card (the
                   average reads slower than the map ever feels). Five keystrokes to the word, the
                   typing-test unit the game's HUD and results screen use. *@
                @if (Model.Wpm is double wpm)
                {
                    <span class="chip-label" title="target words per minute: the average WPM across the fastest fifth of the map's lyric lines of three words or more">@wpm.ToString("0", CultureInfo.InvariantCulture) WPM</span>
                }
                @if (Model.HasPolyglot)
                {
                    @* Backlog 332: the difficulty carries its lyrics in their original script. *@
                    <abbr class="chip-polyglot" data-polyglot-available title="@Model.PolyglotTitle">PG</abbr>
                }
            </span>
            }
        </span>
    </div>
    <div class="bset-card__rail">
        @if (sessionUser is not null)
        {
            <form class="js-fav-form" method="post" asp-page="/Beatmapsets/Set" asp-route-id="@Model.Id" asp-page-handler="Favourite">
                <input type="hidden" name="returnUrl" value="@returnUrl" />
                <button type="submit" data-fav-btn class="rail-btn @(Model.IsFavourited ? "is-on" : "")"
                        aria-label="@(Model.IsFavourited ? "Remove from favourites" : "Add to favourites")">
                    @(Model.IsFavourited ? "♥" : "♡")
                </button>
            </form>
        }
        else
        {
            <a class="rail-btn" href="/login" title="Sign in to favourite" aria-label="Sign in to favourite">&#9825;</a>
        }
        @if (playMode)
        {
            @* Play mode (the /play picker): launch the in-browser player instead of downloading.
               data-status is what makes the post-submit copy honest on a non-ranked map: the
               player has to be able to say "this map is not ranked" rather than guessing. The
               visitor sees the same fact up in .bset-card__meta, where the status pill already
               renders on every card, play mode included. *@
            <button type="button" class="rail-btn tb-play" data-set-id="@Model.Id"
                    data-title="@displayTitle" data-artist="@displayArtist" data-status="@Model.Status"
                    title="Play in browser" aria-label="Play in browser">&#9654;</button>
        }
        else if (showDownloadChoice)
        {
            @* Has video: the click opens the panel below instead of starting a download. The panel
               is the only thing that links the two packages, so with JS off this button does
               nothing; that is why the NO-video card below keeps its plain <a> verbatim, and it is
               also why the panel's first option is the same href the plain arm has. *@
            <button type="button" class="rail-btn" data-dl-toggle aria-expanded="false"
                    title="Download" aria-label="Download">&#8595;</button>
        }
        else if (Model.HasPackage)
        {
            <a class="rail-btn" href="/beatmapsets/@Model.Id/download" title="Download" aria-label="Download">&#8595;</a>
        }
        else
        {
            @* Pre-M3 set with no uploaded package: never link a 404. *@
            <span class="rail-btn rail-btn--disabled" title="available in-game only">&#8595;</span>
        }
    </div>
    @if (showWebplay)
    {
        @* Published + playable (CanWebplay): one tall rail spanning the favourite and download
           rows, deep-linking the browser player straight onto this set. Non-playable cards render
           nothing here, so they keep exactly today's two-column geometry. *@
        <a class="bset-card__play" href="/play?set=@Model.Id"
           title="Play in browser" aria-label="Play @displayTitle in browser">
            <span class="bset-card__play-glyph" aria-hidden="true">&#9654;</span>
            <span class="bset-card__play-label">play</span>
        </a>
    }
    @if (showDownloadChoice)
    {
        @* The two-option panel: a card-covering overlay (a child of .bset-card, which is
           position:relative + overflow:hidden, so it can never bleed past the tile) that grows out
           of a hairline on the card's horizontal midline. Closed it is visibility:hidden, so its
           links are out of the tab order until it opens. The sizes are fetched once, on first
           open, from data-dl-sizes; the text below is what shows until then (and forever, if the
           fetch fails or JS never runs). *@
        <div class="bset-card__dl" data-dl-panel data-dl-sizes="/beatmapsets/@Model.Id/download-sizes"
             role="group" aria-label="Download @displayTitle">
            <a class="bset-card__dl-option" href="/beatmapsets/@Model.Id/download">
                <span class="bset-card__dl-name">with video</span>
                <span class="bset-card__dl-size" data-dl-size-full>full package</span>
            </a>
            <a class="bset-card__dl-option" href="/beatmapsets/@Model.Id/download?noVideo=1">
                <span class="bset-card__dl-name">audio only, no video</span>
                <span class="bset-card__dl-size" data-dl-size-audio>smaller download</span>
            </a>
        </div>
    }
</article>
