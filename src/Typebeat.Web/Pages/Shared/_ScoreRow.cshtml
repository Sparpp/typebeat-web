@using System.Globalization
@model ScoreRowModel
@{
    bool preferOriginal = Context.SessionUser()?.PreferOriginalMetadata ?? false;
    string displayTitle = Model.DisplayTitle(preferOriginal);
    string displayArtist = Model.DisplayArtist(preferOriginal);
}
<div class="score-row">
    <div class="score-row__thumb">
        @if (Model.CoverUrl is not null)
        {
            <img src="@Model.CoverUrl" alt="" loading="lazy" />
        }
        else
        {
            <div class="cover-fallback" aria-hidden="true"></div>
        }
    </div>
    <div class="score-row__mapcol">
        <a class="score-row__map" href="/beatmapsets/@Model.SetId" title="@displayTitle [@displayArtist]">
            @displayTitle <span class="score-row__artist">[@displayArtist]</span>
        </a>
        @if (!string.IsNullOrEmpty(Model.Version))
        {
            <span class="score-row__diff">@Model.Version</span>
        }
    </div>
    <span class="grade @Model.GradeClass">@Model.GradeLabel</span>
    <span class="score-row__completion" title="completion: the % of the map typed; what the grade is awarded on">@((Model.Completion * 100).ToString("0.00", CultureInfo.InvariantCulture))%</span>
    <span class="score-row__acc" title="accuracy: timing quality">@((Model.Accuracy * 100).ToString("0.00", CultureInfo.InvariantCulture))%</span>
    <partial name="_ModIcons" model="Model.ModAcronyms" />
    <span class="score-row__score">@Model.TotalScore.ToString("N0", CultureInfo.InvariantCulture)</span>
    <span class="score-row__date faint">@Model.Date.ToString("d MMM yyyy", CultureInfo.InvariantCulture)</span>
</div>
