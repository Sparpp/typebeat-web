@using System.Globalization
@model ScoreRowModel
@{
    var rowUser = Context.SessionUser();
    bool preferOriginal = rowUser?.PreferOriginalMetadata ?? false;
    string displayTitle = Model.DisplayTitle(preferOriginal);
    string displayArtist = Model.DisplayArtist(preferOriginal);
    // Pin control: own-score-only, so the form posts to the signed-in user's OWN profile page
    // (that is the only place these rows carry the control, and the handler acts on the session
    // user regardless of whose profile the POST names).
    bool showPin = Model.ShowPinControl && rowUser is not null;
}
<div class="score-row">
    <div class="score-row__thumb">
        @if (Model.CoverUrl is not null)
        {
            <img src="@Model.CoverUrl" alt="" width="150" height="150" loading="lazy" />
        }
        else
        {
            <div class="cover-fallback" aria-hidden="true"></div>
        }
    </div>
    <div class="score-row__mapcol">
        <span class="score-row__titlerow">
            <a class="score-row__map" href="/beatmapsets/@Model.SetId" title="@displayTitle [@displayArtist]">
                @displayTitle <span class="score-row__artist">[@displayArtist]</span>
            </a>
            @if (Model.Explicit)
            {
                <partial name="_ExplicitBadge" />
            }
        </span>
        @if (!string.IsNullOrEmpty(Model.Version))
        {
            <span class="score-row__diff">@Model.Version</span>
        }
    </div>
    <span class="grade @Model.GradeClass">@Model.GradeLabel</span>
    <span class="score-row__completion" title="completion: the % of the map typed; what the grade is awarded on">@((Model.Completion * 100).ToString("0.00", CultureInfo.InvariantCulture))%</span>
    <span class="score-row__acc" title="accuracy: timing quality">@((Model.Accuracy * 100).ToString("0.00", CultureInfo.InvariantCulture))%</span>
    @* pp, opt-in per row (only the Best scores section sets this today; see ScoreRowModel.Pp),
       and on that section the row's headline figure, since it is what the section is ordered by.
       0 is an honest value (a custom-rate or not-yet-priced play), it still renders, just quieter. *@
    @if (Model.Pp is double pp)
    {
        <span class="score-row__pp @(pp <= 0 ? "score-row__pp--zero" : "")" title="performance points">@pp.ToString("N0", CultureInfo.InvariantCulture)pp</span>
    }
    <partial name="_ModIcons" model="Model.Mods" />
    <span class="score-row__score">@Model.TotalScore.ToString("N0", CultureInfo.InvariantCulture)</span>
    <span class="score-row__date faint">@Model.Date.ToString("d MMM yyyy", CultureInfo.InvariantCulture)</span>
    @* Watch count, on the sections that ask for it (the profile's "Most viewed replays"); zero is
       rendered as nothing at all, so the ordinary score row keeps exactly the columns it had. *@
    @if (Model.ReplayViews > 0)
    {
        <span class="score-row__views" title="times other players watched this replay">@Model.ReplayViews.ToString("N0", CultureInfo.InvariantCulture) @(Model.ReplayViews == 1 ? "view" : "views")</span>
    }
    @* Replays only exist for plays whose client uploaded one; the slot is reserved either way so
       rows with and without a replay stay aligned. *@
    <span class="score-row__replay">
        @if (Model.HasReplay)
        {
            <a href="/api/v2/scores/@Model.ScoreId/replay" title="Download this replay (.osr)">replay</a>
        }
    </span>
    @* Pin/unpin, owner-only. A plain form POST with the antiforgery token the form tag helper
       injects, then POST-redirect-GET: unlike the favourite heart, a pin CHANGES THE PAGE
       (a row appears in or leaves the Pinned section above), so there is nothing an in-place
       JS toggle could correctly update. No JS involved at all. *@
    @if (showPin)
    {
        <form class="score-row__pinform" method="post" asp-page="/Users/Profile"
              asp-route-idOrName="@rowUser!.Id" asp-page-handler="@(Model.IsPinned ? "Unpin" : "Pin")">
            <input type="hidden" name="scoreId" value="@Model.ScoreId" />
            <button type="submit" class="score-row__pin @(Model.IsPinned ? "is-on" : "")"
                    title="@(Model.IsPinned ? "Unpin this score from your profile" : "Pin this score to your profile")">
                @(Model.IsPinned ? "unpin" : "pin")
            </button>
        </form>
    }
</div>
