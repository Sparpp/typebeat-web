@page "/forgot-password"
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Reset your password";
}

<div class="card auth-card">
    <h1>Reset your password</h1>

    <p class="muted">Enter the email address on your account and we'll send you a 6-digit code to set a new password.</p>

    @if (Model.Error is not null)
    {
        <div class="alert-error">@Model.Error</div>
    }

    <form method="post">
        @Html.AntiForgeryToken()
        <div class="field">
            <label asp-for="Email">Email address</label>
            <input class="input" asp-for="Email" type="email" autocomplete="email" required />
        </div>
        <button type="submit" class="btn btn-primary">Send reset code</button>
    </form>

    <p class="card-note">Remembered it? <a href="/login">Sign in</a>.</p>
</div>
