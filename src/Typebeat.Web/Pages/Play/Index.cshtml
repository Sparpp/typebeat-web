@page "/play"
@model Typebeat.Web.Pages.Play.IndexModel
@{
    // Backlog 418: indexed, so it carries its own title and description.
    ViewData["FullTitle"] = "Play online free, no download: typing to music · type!beat";
    ViewData["MetaDescription"] = "Play type!beat free in your browser: pick a song and type the lyrics in time with the music. No download, no account needed. Sign in to save your scores and earn pp.";
    ViewData["CardPlayMode"] = true; // the shared card renders a play button instead of download
    var user = Model.CurrentUser;
    var auto = Model.AutoPlay;
    bool preferOriginal = user?.PreferOriginalMetadata ?? false;
}

<section class="play-head">
    <h1>play in your browser</h1>
    @* The sign-in prompt is the only thing left under the heading, so the whole
       paragraph goes with it: a signed-in visitor would otherwise get an empty one. *@
    @if (user is null)
    {
        <p class="play-sub"><a href="/login">sign in</a> to save your scores to the leaderboard and earn pp on ranked maps.</p>
    }
</section>

<div id="tb-picker" class="play-picker">
    @if (Model.Maps.Count == 0)
    {
        <div class="play-empty">No playable maps yet, check back soon.</div>
    }
    else
    {
        @* Inside the picker so it hides with it when a run starts (backlog 418). *@
        <div class="play-intro">
            <p>Pick a map below and type the lyrics as they're sung. No download, no account.</p>
            <p>Only letters, numbers and spaces count, so don't worry about capitals or punctuation. A hyphen counts as a space. You can pause (Esc), retry or quit a run, and skip long instrumental breaks. Every run ends with your score, accuracy, WPM, best combo, typos and your count of Greats, Oks, Mehs and misses.</p>
            <p>Mods, rate changes and the map editor live in the desktop client.</p>
            <p>type!beat is played on a physical keyboard.</p>
        </div>
        <div class="card-grid">
            @foreach (var set in Model.Maps)
            {
                <partial name="_BeatmapsetCard" model="set" />
            }
        </div>
    }
</div>

@* data-discord-url is the one invite constant reaching the player: the post-clear nudge reads it
   off this root rather than hardcoding the URL a second time in JavaScript. *@
<div id="tb-stage" class="play-stage-wrap" data-discord-url="@SiteLinks.DISCORD_INVITE" hidden>
    <button type="button" id="tb-close" class="btn btn-ghost btn-small play-close">✕ close</button>
    <div id="tb-stage-mount"></div>
</div>

<script>
    window.TYPEBEAT_PLAY = {
        signedIn: @(user is not null ? "true" : "false"),
        csrf: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CsrfToken)),
        // The content hash of the three scripts below (backlog 312), computed once at startup.
        // play.js sends it with every token, and the server registers it as this run's build
        // ('web-' + revision), so a tab left open across a deploy keeps its own build identity.
        revision: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Typebeat.Web.Endpoints.PlayEndpoints.Revision)),
        // ?set={id}[&diff={beatmapId}] deep link (the beatmapset card's play rail): load this map
        // immediately. diffId 0 means "not named, or named something this set does not have", and
        // the player then opens on its difficulty step exactly as a card click does.
        autoPlay: @Html.Raw(auto is null
            ? "null"
            : System.Text.Json.JsonSerializer.Serialize(new
              {
                  setId = auto.Id,
                  title = auto.DisplayTitle(preferOriginal),
                  artist = auto.DisplayArtist(preferOriginal),
                  status = auto.Status,
                  diffId = Model.AutoPlayDiffId,
              }))
    };
</script>
<script src="~/js/typebeat-core.js" asp-append-version="true"></script>
<script src="~/js/typebeat-player.js" asp-append-version="true"></script>
<script src="~/js/play.js" asp-append-version="true"></script>
